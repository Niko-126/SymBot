{
  "name": "symbot-desktop",
  "productName": "SymBot",
  "version": "0.1.0",
  "private": true,
  "description": "SymBot 衡忆 · Electron 桌面壳：拉起 Python 内核，窗口加载本地面板，关窗收进托盘",
  "main": "main.js",
  "author": "SymBot",
  "license": "SEE LICENSE IN ../LICENSE",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis",
    "pack": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },

  "build": {
    "appId": "com.symbot.desktop",
    "productName": "SymBot",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "assets/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "SymBot 衡忆"
    }
  }
}
